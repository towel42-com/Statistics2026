root = true

[*.cs]
# Silence noisy defaults while keeping your chosen rules active
dotnet_analyzer_diagnostic.severity = none

# Your enabled rules
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA2012.severity = warning
dotnet_diagnostic.VSTHRD107.severity = warning
dotnet_diagnostic.VSTHRD110.severity = warning
dotnet_diagnostic.MA0134.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

# Required so IDE0008 knows to flag 'var' on method return values
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:warning

# AsyncFixer rules
dotnet_diagnostic.AsyncFixer01.severity = warning   # Unnecessary async/await
dotnet_diagnostic.AsyncFixer02.severity = warning   # Blocking calls (.Result/.Wait) inside async methods
dotnet_diagnostic.AsyncFixer03.severity = warning   # Fire-and-forget async void methods/delegates
dotnet_diagnostic.AsyncFixer04.severity = warning   # Unawaited async call inside a using block
dotnet_diagnostic.AsyncFixer05.severity = warning   # Nested Task from TaskFactory.StartNew
dotnet_diagnostic.AsyncFixer06.severity = warning   # Implicit Task<T> to Task conversion discarding result
